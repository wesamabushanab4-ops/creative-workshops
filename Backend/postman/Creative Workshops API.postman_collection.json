{
  "info": {
    "_postman_id": "43f53bc0-27cc-4cf2-9c0b-c66caddd9f32",
    "name": "Creative Workshops API",
    "description": "CRUD requests for the Creative Workshops assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "instructorId", "value": "" },
    { "key": "workshopId", "value": "" }
  ],
  "item": [
    {
      "name": "List instructors",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/instructors" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns instructors', () => pm.response.to.have.status(200));",
              "const instructors = pm.response.json();",
              "if (instructors.length) pm.collectionVariables.set('instructorId', instructors[0]._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List workshops for instructor",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/workshops?instructorId={{instructorId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns workshops', () => pm.response.to.have.status(200));",
              "const workshops = pm.response.json();",
              "if (workshops.length) pm.collectionVariables.set('workshopId', workshops[0]._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get one workshop",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/workshops/{{workshopId}}" }
    },
    {
      "name": "Create workshop",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instructorId\": \"{{instructorId}}\",\n  \"startAt\": \"2030-06-15T10:00:00.000Z\",\n  \"endAt\": \"2030-06-15T12:00:00.000Z\",\n  \"topic\": \"Postman test workshop\",\n  \"room\": \"Studio B\"\n}"
        },
        "url": "{{baseUrl}}/api/workshops"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Workshop created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('workshopId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update workshop",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instructorId\": \"{{instructorId}}\",\n  \"startAt\": \"2030-06-15T10:00:00.000Z\",\n  \"endAt\": \"2030-06-15T12:30:00.000Z\",\n  \"topic\": \"Updated workshop\",\n  \"room\": \"Art Room\"\n}"
        },
        "url": "{{baseUrl}}/api/workshops/{{workshopId}}"
      }
    },
    {
      "name": "Reject past workshop creation",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instructorId\": \"{{instructorId}}\",\n  \"startAt\": \"2020-01-01T10:00:00.000Z\",\n  \"endAt\": \"2020-01-01T12:00:00.000Z\",\n  \"topic\": \"Invalid past workshop\",\n  \"room\": \"Studio B\"\n}"
        },
        "url": "{{baseUrl}}/api/workshops"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Past start is rejected', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject end before start",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instructorId\": \"{{instructorId}}\",\n  \"startAt\": \"2030-06-15T12:00:00.000Z\",\n  \"endAt\": \"2030-06-15T10:00:00.000Z\",\n  \"topic\": \"Invalid time range\",\n  \"room\": \"Studio B\"\n}"
        },
        "url": "{{baseUrl}}/api/workshops"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid time range is rejected', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete workshop",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/workshops/{{workshopId}}" }
    }
  ]
}
